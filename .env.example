# Local SQLite dev (instead of Postgres):
#   npm run db:sqlite:setup && npm run db:sqlite:seed
# and run the dev server with:  DATABASE_URL="file:./dev.db" npm run dev
# (uses prisma/schema.sqlite.prisma; models are identical to Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@portfolio.dev"
ADMIN_PASSWORD="admin123"

RESEND_API_KEY="re_your_resend_api_key"
CONTACT_EMAIL="syaraffiras@gmail.com"

# Optional Nodemailer fallback (only used if RESEND_API_KEY is unset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Portfolio <portfolio@example.com>"
